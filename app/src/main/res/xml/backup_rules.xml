<?xml version="1.0" encoding="utf-8"?>
<!-- Plaintext note copies and keys that cannot be restored must stay out of Auto Backup. -->
<full-backup-content>
    <exclude domain="sharedpref" path="encrypted_prefs.xml" />
    <exclude domain="file" path="vault-scan-cache/" />
    <exclude domain="file" path="vault-recovery/" />
    <exclude domain="file" path="vault-history/" />
</full-backup-content>
